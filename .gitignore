/.vs/
*.suo

/bin/
/build/

# Local runtime output from BBCF/mod runs.
/BBCF_IM/
/CrashReports/
/DEBUG.txt
/*.log
/*.dmp

# Python/script caches from local analysis helpers.
__pycache__/
*.pyc

# Ghidra generated project databases are large binary artifacts.
# Keep headless scripts/reports tracked and regenerate this folder locally.
docs/Research/BBCF-Ghidra-Project/

# URT automation local outputs.
tools/urt_automation/runtime/
/.claude/worktrees

# Regenerated on every build (BeforeBuild target); never stable enough to check in.
src/Core/BuildInfo.autogen.h

# Local deploy paths (machine-specific; template committed as DeploySettings.props.example)
deploy/DeploySettings.props
