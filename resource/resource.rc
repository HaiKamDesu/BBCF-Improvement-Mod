// Localization resources packaged into the DLL so external files aren't required at runtime.
#include <windows.h>

"Localization.csv" RCDATA "localization\\Localization.csv"

// Branding artwork drawn by the mod menu (title bar wordmarks, background watermark).
// Embedded rather than shipped as loose files so the DLL stays self-contained.
"Logo_Oceanya.png" RCDATA "branding\\Logo_Oceanya.png"
"Logo_Laboratories.png" RCDATA "branding\\Logo_Laboratories.png"
"Logo_O_Centered.png" RCDATA "branding\\Logo_O_Centered.png"

// Config templates. Releases ship only the DLL and the updater, so the mod writes these
// out itself on first run (and refreshes the updater's ".default" copies every launch).
"settings.ini" RCDATA "settings.ini"
"palettes.ini" RCDATA "palettes.ini"

// Per-character palette reference sheets (HIKARI's, see tools/build_palette_templates.py).
// Pixel indices only, deflated: 43 MB of sheets in 2.4 MB.
"palette_templates" RCDATA "palette_templates.bin"
