<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy to DeploySettings.props and edit. That filename is gitignored, because these
       paths are specific to your machine. The import in BBCF_IM.vcxproj is conditional on
       the file existing, so a clone without one builds normally - it just cannot deploy. -->
  <PropertyGroup>
    <BbcfDeployEnabled>true</BbcfDeployEnabled>
    <BbcfInstallDir>C:\Path\To\steamapps\common\BlazBlue Centralfiction</BbcfInstallDir>
    <BbcfCopyDll>true</BbcfCopyDll>
    <BbcfCopyPalettes>false</BbcfCopyPalettes>
    <BbcfCopySettings>false</BbcfCopySettings>
    <!-- false keeps a build from launching the game behind you -->
    <BbcfLaunchAfterDeploy>false</BbcfLaunchAfterDeploy>
    <BbcfLaunchCommand>powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process 'C:\Program Files (x86)\Steam\steam.exe' -ArgumentList '-applaunch 586140'"</BbcfLaunchCommand>
    <BbcfDebuggerCommand>C:\Path\To\steamapps\common\BlazBlue Centralfiction\BBCF.exe</BbcfDebuggerCommand>
    <BbcfDebuggerArguments></BbcfDebuggerArguments>
    <BbcfDebuggerWorkingDirectory>C:\Path\To\steamapps\common\BlazBlue Centralfiction</BbcfDebuggerWorkingDirectory>
  </PropertyGroup>
</Project>
