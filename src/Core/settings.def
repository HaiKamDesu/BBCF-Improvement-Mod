// Shortcuts for sharing player-created rooms: copy puts a steam://joinlobby link for the
// room you are in on the clipboard, join opens such a link from the clipboard so the Steam
// client hands it back to the game. Both are inert while an ImGui text field has keyboard
// focus. See src/Network/LobbyLinkManager.h.
// Ctrl used to be hardcoded in the polling code and the value here was a bare letter;
// HotkeyManager::ReloadFromSettings migrates such values by re-adding the Ctrl.
SETTING(bool, lobbyLinkHotkeysEnabled, "LobbyLinkHotkeysEnabled", "1");
SETTING(std::string, copyLobbyLinkKeybind, "CopyLobbyLinkKeybind", "Ctrl+C");
SETTING(std::string, joinLobbyLinkKeybind, "JoinLobbyLinkKeybind", "Ctrl+V");
SETTING(std::string, dinputDllWrapper, "DinputDllWrapper", "none");
