// X-Macro file for settings.ini definitions
// Warning: std::string types must be handled separately in code when printing.
// format: (type, cname, ininame, default value)

SETTING(std::string, togglebutton, "ToggleButton", "F1");
SETTING(std::string, toggleOnlineButton, "ToggleOnlineButton", "F2");
// Opens the PC & connection stats window (closes it if it is already open). Modifiers match exactly, so plain F2 does not fire on Ctrl+F2.
SETTING(std::string, toggleOnlinePerformanceButton, "ToggleOnlinePerformanceButton", "Ctrl+F2");
SETTING(std::string, toggleHUDbutton, "ToggleHUDButton", "F3");
SETTING(std::string, saveStateKeybind, "SaveStateKeybind", "F5");
SETTING(std::string, loadStateKeybind, "LoadStateKeybind", "F9");
SETTING(std::string, loadReplayStateKeybind, "LoadReplayStateKeybind", "F4");
SETTING(std::string, freezeFrameKeybind, "freezeFrameKeybind", "C");
SETTING(std::string, stepFramesKeybind, "stepFramesKeybind", "V");
// Replay Extras' "Rewind" button, as a key. Works while a replay is running whether or not
// the Replay Extras window is on screen.
SETTING(std::string, replayRewindKeybind, "ReplayRewindKeybind", "R");
// Shortcuts for sharing player-created rooms: copy puts a steam://joinlobby link for the
// room you are in on the clipboard, join opens such a link from the clipboard so the Steam
// client hands it back to the game. Both are inert while an ImGui text field has keyboard
// focus. See src/Network/LobbyLinkManager.h.
// Ctrl used to be hardcoded in the polling code and the value here was a bare letter;
// HotkeyManager::ReloadFromSettings migrates such values by re-adding the Ctrl.
SETTING(bool, lobbyLinkHotkeysEnabled, "LobbyLinkHotkeysEnabled", "1");
SETTING(std::string, copyLobbyLinkKeybind, "CopyLobbyLinkKeybind", "Ctrl+C");
SETTING(std::string, joinLobbyLinkKeybind, "JoinLobbyLinkKeybind", "Ctrl+V");
// TAS mode frame-editor shortcuts. Only active while the TAS window is open; see
// src/Game/TasManager.h and src/Overlay/Window/TasWindow.cpp.
SETTING(std::string, tasParseKeybind, "TasParseKeybind", "I");
SETTING(std::string, tasRewindKeybind, "TasRewindKeybind", "J");
SETTING(std::string, tasAdvanceKeybind, "TasAdvanceKeybind", "L");
SETTING(std::string, dinputDllWrapper, "DinputDllWrapper", "none");
SETTING(int, renderwidth, "RenderingWidth", "1920");
SETTING(int, renderheight, "RenderingHeight", "1080");
SETTING(int, viewport, "Viewport", "1");
SETTING(int, antialiasing, "AntiAliasing", "-1");
SETTING(bool, vsync, "V-sync", "0");
SETTING(int, menusize, "MenuSize", "2");
SETTING(bool, notifications, "Notifications", "1");
SETTING(bool, checkupdates, "CheckUpdates", "1");
// Pausing a replay makes the game hide its input display - the button columns down both sides
// and the two stick-and-button panels. With this on, they stay up while paused. Only affects
// Replay Theater, and the pause still pauses; see src/Game/ReplayPauseHud.h for why that last
// part is worth saying out loud.
SETTING(bool, showHudWhenReplayPaused, "ShowHudWhenReplayPaused", "0");
SETTING(bool, generateDebugLogs, "GenerateDebugLogs", "1");
// Diagnostic only, off by default. While on, every time the training dummy enters a timed
// state (getup, tech, roll, stagger recovery, throw escape) or starts blocking, the dummy is
// fed a fresh A or B press on every frame (alternating, so each frame is a new press edge)
// through the same runtime playback the dummy-action triggers use, and DEBUG.txt gets an
// "[UP][PROBE] <state> (char N): first move started on frame X of the state, rule predicted Y"
// line - the ground truth for the first-actionable rule in UnlimitedPlaybackManager. Armed
// triggers do not fire while it is on. See docs/Research/TriggerTimingInvestigation.md.
SETTING(bool, triggerTimingProbe, "TriggerTimingProbe", "0");
// Diagnostic only. Calls the game's own "does this entity have active hitboxes" routine
// (BBCF.exe+0x18C3E0) once per entity per frame and writes its answer, and the six fields it
// reads, to DEBUG.txt. Used to work out why some hitboxes never draw. Off by default: it calls
// into game code from the render thread, which is not something to leave running.
SETTING(bool, entityHitboxProbeEnabled, "EntityHitboxProbeEnabled", "0");
// How much memory a crash dump captures. Full memory was the old behaviour and made every
// dump ~500 MB, which is why CrashReports folders reached 14 GB and reporter bundles had to
// be split across several archives to be sent at all. Medium keeps everything the crash
// context and a stack walk need and drops the bulk texture/audio memory.
// enum: 0 = small, 1 = medium, 2 = full. Keep in the same order as
// kCrashDumpDetailOptions in SettingsIniWindow.cpp.
SETTING(int, crashDumpDetail, "CrashDumpDetail", "1");
// Oldest-first prune of BBCF_IM\CrashReports before each new bundle is written. 0 keeps
// every bundle forever, which is the behaviour that let the folder grow unbounded.
SETTING(int, crashReportsToKeep, "CrashReportsToKeep", "5");
SETTING(bool, showRankedProgress, "ShowRankedProgress", "0");
SETTING(bool, showSquareColorProgress, "ShowSquareColorProgress", "0");
SETTING(bool, showRankedPrediction, "ShowRankedPrediction", "1");
SETTING(bool, rankedProgressShowMatches, "RankedProgressShowMatches", "1");
SETTING(bool, rankedProgressShowWins, "RankedProgressShowWins", "1");
SETTING(bool, rankedProgressShowLosses, "RankedProgressShowLosses", "0");
SETTING(bool, rankedProgressShowWinrate, "RankedProgressShowWinrate", "1");
SETTING(bool, rankedProgressShowCharacterLeaderboardPlacement, "RankedProgressShowCharacterLeaderboardPlacement", "0");
SETTING(bool, rankedProgressShowGlobalLeaderboardPlacement, "RankedProgressShowGlobalLeaderboardPlacement", "0");
// Ranked "match found with two strangers": joining a host whose game-side room
// still holds a previous match's pair puts us in a slot outside that pair
// (matchPlayerIndex >= 2, matchId 0) and the popup renders the stale pair, both
// already OK. Nothing progresses until RankMatchLeaveMyself ~2 min later. Detect
// it ~300ms after LobbyEnter, mark the lobby broken and the host unreachable
// right away, and say so on screen. See docs/Research/RankedStaleRoom.md.
SETTING(bool, rankedStaleRoomDetect, "RankedStaleRoomDetect", "1");
// Additionally leave the stale lobby automatically. Off by default: nothing in
// the mod has ever left a lobby on the game's behalf, so this is proven in the
// field before it is turned on for everyone.
SETTING(bool, rankedStaleRoomAutoLeave, "RankedStaleRoomAutoLeave", "0");
// Writes a running account of the online lobby system to DEBUG.txt ([LobbyTrace]): every
// Steam lobby call and its result, Steam's lobby and P2P events, P2P traffic per peer, the
// game's lobby messages, the network task's states and dialogs, the room member table and
// GGPO assertions. Observation only - it changes nothing the game does. Used to find out
// where joins and connections fail; see docs/Decompilation/Lobby.md.
SETTING(bool, lobbyTrace, "LobbyTrace", "1");
// Client-side fixes to the online lobby system (docs/Decompilation/Lobby.md, "Fixes in the
// mod"): searches skip full lobbies, every listed lobby gets its connection rating (lost
// pings are re-sent), the join handshake only accepts reject / room info /
// room closed from the room's host, the ranked pre-match upload gets its timeout back, and
// profile requests are no longer re-sent while the first is still running (sign-in drops).
// Nothing changes on the wire, so it plays with vanilla clients. 0 = vanilla behaviour.
SETTING(bool, lobbyFixes, "LobbyFixes", "1");
SETTING(bool, rankedAutomationHarnessEnabled, "RankedAutomationHarnessEnabled", "0");
SETTING(std::string, rankedAutomationHarnessHotkey, "RankedAutomationHarnessHotkey", "F8");
SETTING(std::string, toggleJukeboxButton, "ToggleJukeboxButton", "F10");
SETTING(std::string, nextTrackButton, "NextTrackButton", "F11");
SETTING(bool, rankedAutomationHarnessAutorun, "RankedAutomationHarnessAutorun", "0");
SETTING(bool, rankedAutomationHarnessQuitOnFinish, "RankedAutomationHarnessQuitOnFinish", "0");
// Watchdog for the "D-Code bug": when a per-room-member profile fetch wedges
// (state 6 payload-rejected, or a >15s state-2 stall), force the slot back to
// idle so the game's own retry path re-fetches. See docs/Research/DCodeNetworkStallBug.md.
SETTING(bool, dcodeAutoRecover, "DCodeAutoRecover", "1");
// TEST ONLY: sabotage the first in-flight profile fetch after launch (corrupts
// the receive buffer so the game's checksum rejects it) to exercise the state-6
// wedge + auto-recovery end-to-end. Fires once per launch while set to 1.
SETTING(bool, dcodeForceFailureOnce, "DCodeForceFailureOnce", "0");
// When the game latches its "network profile storage unavailable" flag (which
// silently stops uploading your profile, so ranked/net-color progress is lost on
// restart), reset it so uploads resume. See docs/Research/DCodeNetworkStallBug.md.
SETTING(bool, dcodeTusGateAutoClear, "DCodeTusGateAutoClear", "1");
// The actual D-Code / ranked-rollback fix. The profile transport is an ArcSys
// HTTP API, and when the server starts rejecting our session (work-manager
// result 11, response param.status 3) every profile read AND write fails for
// the rest of the process -- so progress earned from that point is discarded on
// restart. Only a fresh user/login mints a usable session, which is why
// restarting the game has always been the only cure. On a failure streak this
// re-runs that login in place. See docs/Research/DCodeNetworkStallBug.md.
SETTING(bool, dcodeAutoRelogin, "DCodeAutoRelogin", "1");
SETTING(bool, dcodeRetryOnRejection, "DCodeRetryOnRejection", "1");
// Replaces the game's network-entry profile sync (src/Network/ProfileSync.cpp). The game
// treats ANY failed profile download as "you have no profile" and offers to create a new
// one, which overwrites the real profile on the server. With this on, failures are retried
// (signing in again when the server dropped the session), "create new" needs two explicit
// confirmations, and a blank or failed profile can never be uploaded.
// See docs/Research/ProfileResetPromptInvestigation.md.
SETTING(bool, profileSyncRewrite, "ProfileSyncRewrite", "1");
// Keeps an encrypted copy of your network profile in BBCF_IM\ProfileBackup, refreshed every
// time the server confirms it. Only ever used when the server answers that it has no profile
// for you at all; it can never be used to roll a profile back.
SETTING(bool, profileBackup, "ProfileBackup", "1");
// TEST ONLY: make the first N own-profile downloads at network entry fail the way a real
// failure does (buffer zeroed, loader state 6), to exercise the retries and the dialog.
// A forced failure can never trigger the backup restore; only a real "no data" answer from
// the server can, or this switch would be a way to roll a profile back.
SETTING(int, profileSyncTestFailures, "ProfileSyncTestFailures", "0");
// TEST ONLY: corrupt one byte of the live session token so the server rejects
// it exactly the way the real bug does (result 11 / status 3), to exercise the
// re-login fix above end-to-end without waiting days for a natural occurrence.
// Fires once per launch while set to 1.
SETTING(bool, dcodeForceSessionWedge, "DCodeForceSessionWedge", "0");
// Spectator desync fix: when the spectator's SyncInput would report starvation
// (input not yet received over the network), substitutes the previous frame's real
// input instead of letting the game's caller advance the simulation with a fake
// zeroed input (the desync mechanism). Always active while spectatorSyncHooksEnabled
// is on -- there is no separate on/off toggle for the fix itself, since substitution
// is unconditionally safer than both the original bug and the retired "force stall"
// attempt (see docs/Research/SpectatorDesyncInvestigation.md for why that one
// crashed the game with a GGPO event-queue assertion, and why this design doesn't).
// Kill-switch for the spectator-sync hooks (SpectatorSyncInputEntry +
// SpectatorSyncStarvation). 1 = install as normal (default). 0 = don't install them
// at all, falling back to pure vanilla behavior (the original desync bug, unfixed).
// Read at startup only -- requires a restart to take effect either way.
SETTING(bool, spectatorSyncHooksEnabled, "SpectatorSyncHooksEnabled", "1");
// FPS-drop investigation (2026-08-02 Discord reports, unconfirmed as mod-caused):
// when enabled, measures real frame-to-frame time each match frame and, if a
// frame exceeds FrameStallThresholdMs, logs a breakdown of how much of that
// time was spent inside the mod's own EndScene hook code versus outside it
// (base game/driver/OS) to DEBUG.txt and BBCF_IM\FrameStallIncidents.log.
// See src/Game/FrameStallDiagnostics.h.
SETTING(bool, logFrameStalls, "LogFrameStalls", "0");
SETTING(int, frameStallThresholdMs, "FrameStallThresholdMs", "33");
// How often the "load-replay" Steam launch parameter is polled, in milliseconds.
// This used to run on every rendered frame (~60 ISteamApps IPC calls/second) to read a
// value that only ever changes when the game is launched from a replay link, so it was
// pure background load on Steam's IPC pipe for the entire session.
//
// It is a setting rather than a hardcoded interval because of the 2026-08 FPS-drop
// reports: those stalls are the game blocking inside steamclient.dll, with the mod
// absent from the call path, which is what mod-generated Steam traffic would look like
// from the outside. 0 restores the old every-frame behaviour, so a reporter can A/B the
// two without swapping builds. See ReplayFileManager::check_and_load_replay_steam.
SETTING(int, replayLaunchParamPollMs, "ReplayLaunchParamPollMs", "2000");
// Self-A/B for the overlay's per-frame cost, in seconds (0 = off).
//
// WindowManager::Render builds and submits an ImGui frame on every rendered frame even
// when no overlay window is open. The CPU side of that measures ~0.2ms, but the GPU cost
// of the extra render pass is not measured anywhere - and a sustained framerate loss is
// exactly the symptom that a >33ms stall log cannot see.
//
// When set, the overlay pass is switched on and off every N seconds and the [FrameRate]
// summary is emitted once per switch, tagged with which arm it covered. That yields both
// arms interleaved within one session on the same hardware, instead of asking a reporter
// to run two sessions and hoping conditions matched.
SETTING(int, overlayAbTestSeconds, "OverlayAbTestSeconds", "0");
// Fallback path for when another resident hooker owns d3d9's Direct3DCreate9Ex export and
// evicts our detour before the game creates its device (confirmed with NVIDIA Optimus'
// nvd3d9wrap.dll, which re-applies its own patch ~300ms after ours and drops us out of the
// call chain -- the overlay then never appears). The fallback hooks the game's IMPORT table
// entry instead of the export prologue, which nobody else contends for.
// 0 = Off (never; pure pre-8.3 behavior), 1 = Automatic (default; only when the export is
// already owned by a foreign module at startup, or after we observe our detour evicted),
// 2 = Always (install unconditionally; diagnostic use).
// On a machine where nothing contends for the export, Automatic does nothing at all.
// Enum options rendered by SettingsIniWindow.cpp's kSettingEnumMetadata.
// Read at startup only -- requires a restart to take effect.
SETTING(int, d3d9IatFallbackHook, "D3D9IatFallbackHook", "1");
// Force Platinum's personality/voice (Sena/Luna) for the Platinum YOU control: 0 = Default
// (vanilla RNG), 1 = force Luna, 2 = force Sena. Enum options rendered by
// SettingsIniWindow.cpp's kSettingEnumMetadata. Client-side audio-only override (hooks the
// voice-bank load + play resolvers in hooks_palette.cpp, never writes the game's checksummed
// select-struct field). OFFLINE ONLY: forced off in ONLINE matches (hooks_palette.cpp,
// PlatinumVoiceChoiceForSlot) pending investigation of a field-reported match desync that
// correlated with this override actually changing something online - see the block comment
// there for details. See docs/Research/PlatinumVoiceChoiceInvestigation.md for the full RE writeup.
SETTING(int, platinumVoiceChoice, "PlatinumVoiceChoice", "0");

// What holding Up / Down while pressing the training "reset positions" bind does. Left and
// right always reset to that corner (the game's own behaviour, untouched). Enum, rendered by

// What holding a direction while pressing the training "Reset Positions" button does.
// One setting per direction; the value is an enum rendered as a dropdown by
// SettingsIniWindow.cpp's kSettingEnumMetadata - keep the order in step:
//   0 = Default: what happens today (Up swaps sides - the mod's own feature; Down resets
//       to the middle and Left/Right to that corner - the game's own rule)
//   1 = Nothing (a plain reset, the previous reset position stays)
//   2 = Reset to the middle of the stage
//   3 = Reset to the left corner
//   4 = Reset to the right corner
//   5 = Swap sides
// The game reads the held direction in one function (FUN_006D2D40, hooked in
// hooks_system_input.cpp) and writes the "TRI_ResetPosition" training-menu value from it,
// so remapping means either letting that run, skipping it, or writing the value ourselves -
// never both, which is why Down=swap does not also drag the reset to the middle.
// See docs/Research/ResetLabOverride.md.
SETTING(int, resetLabUpAction, "ResetLabUpAction", "0");
SETTING(int, resetLabDownAction, "ResetLabDownAction", "0");
SETTING(int, resetLabLeftAction, "ResetLabLeftAction", "0");
SETTING(int, resetLabRightAction, "ResetLabRightAction", "0");

// Wave-bank format the custom-music converter writes into its .pac files.
// enum: 0 = Auto, 1 = WMA, 2 = PCM - keep in step with kMusicWaveBankFormatOptions
// in SettingsIniWindow.cpp and with ChooseBankFormat() in CustomMusicConverter.cpp.
//
// Auto picks WMA when a PCM->WMAudioV8 encoder MFT exists and PCM when it does not.
// That is the whole Windows/Proton split: Wine's Media Foundation registers no audio
// encoder of any kind, so WMA cannot be produced there, while the XACT runtime plays
// PCM wave banks perfectly well (the game's own voice banks are PCM). Forcing PCM on
// Windows is supported, and is the only way to exercise that path on a machine that
// has the encoder. PCM files are roughly ten times larger.
SETTING(int, musicWaveBankFormat, "MusicWaveBankFormat", "0");
// Keep the last N sessions' DEBUG.txt files in BBCF_IM\DebugHistory (rotated at
// launch). 0 = old behavior, DEBUG.txt is overwritten every launch.
SETTING(int, debugLogSessionHistory, "DebugLogSessionHistory", "10");
SETTING(bool, urtReTraceEnabled, "URT_RE_TraceEnabled", "0");
SETTING(int, urtReTraceLevel, "URT_RE_TraceLevel", "2");
SETTING(int, urtReTraceMaxFileMB, "URT_RE_MaxFileMB", "16");
SETTING(int, urtReTraceMaxBackups, "URT_RE_MaxBackups", "3");
SETTING(bool, urtReAllowSizeMismatchProbe, "URT_RE_AllowSizeMismatchProbe", "0");
SETTING(bool, urtReAllowUnsafeProbeLoad, "URT_RE_AllowUnsafeProbeLoad", "0");
SETTING(bool, enableInDevelopmentFeatures, "EnableInDevelopmentFeatures", "0");
// Arms a PAGE_GUARD + single-step trap on the page holding the ranked LP slot to find who writes
// it. Reverse-engineering instrument, not a diagnostic: every access to that page by any thread
// costs two kernel exception dispatches, and it re-arms until it sees a value change. A session
// that never sees one logs millions of guard hits and drops the game to a slideshow. It used to
// ride on EnableInDevelopmentFeatures, which made that whole setting unusable during ranked play.
SETTING(bool, rankedSlotWriteTraceEnabled, "RankedSlotWriteTrace", "0");
SETTING(bool, enableRankedListConnectionFilter, "EnableRankedListConnectionFilter", "0");
SETTING(bool, showRankedListFilterWindow, "ShowRankedListFilterWindow", "1");
SETTING(bool, showRankedListHiddenPopup, "ShowRankedListHiddenPopup", "0");
SETTING(int, rankedListSortMode, "RankedListSortMode", "0");
SETTING(int, rankedListNetworkFilter, "RankedListNetworkFilter", "0");
SETTING(bool, hideUnmetRequirementRooms, "HideUnmetRequirementRooms", "0");
// The player room list (Network > Player Match > Search) gets its own copy of the list
// config: same window, separate state. No reachability probing here - only the ranked list
// probes hosts, so there is no "hide unreachable" switch for rooms.
SETTING(bool, showPlayerRoomListFilterWindow, "ShowPlayerRoomListFilterWindow", "1");
SETTING(bool, showPlayerRoomListHiddenPopup, "ShowPlayerRoomListHiddenPopup", "0");
// enum: PlayerRoomListSortMode_ in Network/RankedListConnectionFilter.h
SETTING(int, playerRoomListSortMode, "PlayerRoomListSortMode", "0");
SETTING(int, playerRoomListNetworkFilter, "PlayerRoomListNetworkFilter", "0");
SETTING(bool, playerRoomListHideUnmetRequirement, "PlayerRoomListHideUnmetRequirement", "0");
SETTING(bool, loadforeignpalettes, "LoadForeignPalettesToggleDefault", "1");
// -1 = unset (the mod asks once via an in-game popup), 0 = deny, 1 = allow.
// Frames of GGPO input delay in online matches. The game hardcodes 2 regardless of ping.
// Higher means less rollback for both sides and more input lag for you; it is the setting
// for a bad connection. Lower is NOT the mirror image of that - GGPO stamps your input as
// frame (F + delay), so a smaller number makes your inputs arrive later relative to the
// opponent's simulation and pushes the rollback onto them and onto spectators. So 2 is the
// floor unless EnableInDevelopmentFeatures is on, and 8 (the prediction cap) is the ceiling.
// Applied to the next session, not the one in progress. See src/Game/OnlineInputDelay.h.
SETTING(int, onlineInputDelay, "OnlineInputDelay", "2");
SETTING(int, allowPaletteDownloads, "AllowPaletteDownloads", "-1");
// Run the game as BBCF_IM_4GB.exe, a copy of BBCF.exe with the large-address-aware flag (4 GB of
// address space instead of 2), started by the mod in place of the stock exe (src/Core/LaaRedirect.h).
// enum: -1 = ask in-game, 0 = off, 1 = on. Read straight from settings.ini in DllMain, before the
// rest of the settings load. The mod sets it to 0 itself if the copy dies while starting.
SETTING(int, largeAddressSpace, "LargeAddressSpace", "-1");
SETTING(bool, customPalettesInCharSelect, "CustomPalettesInCharSelect", "1");
// Fallback to the pre-8.9.1 way of making a palette change show on screen: flip the game's live
// colour number between N and N+1 and write the palette into both slots. Off = mark the palette
// dirty and reset the container's upload cache (docs/Decompilation/Palettes.md, "Rewrite design"),
// which never touches the colour number. Only for a character that turns out not to redraw.
SETTING(bool, paletteLegacyIndexToggle, "PaletteLegacyIndexToggle", "0");
// Online mirror matches: the room host gives the second player to confirm colour + 1, and the
// game wraps that to colour 1 (default) from colour 12 up. On = wrap at 24 instead, so a mirror
// on colours 12-24 stays off default. Only has an effect when this client is the room host, and
// every member (spectators too) receives the host's result, so it cannot desync anyone.
SETTING(bool, fixOnlineMirrorColour, "FixOnlineMirrorColour", "1");
SETTING(int, takeoverInputSlot, "TakeoverInputSlot", "0");
SETTING(bool, swapControllerPos, "SwapControllerPos", "0");
// The local input system (src/Input/LocalInputManager.h): every keyboard and controller is
// assigned to Player 1 or Player 2 from the Controllers page, with hot-plug, per-device names
// and button mapping. Replaces the game's own controller handling and the older override
// options below. 0 = the game's own handling plus the older options, as before.
SETTING(bool, newControllerSystem, "NewControllerSystem", "1");
SETTING(bool, EnableControllerHooks, "EnableControllerHooks", "1");
SETTING(bool, ForceEnableControllerSettingHooks, "ForceEnableControllerSettingHooks", "0");
// Lets the mod run on a BBCF.exe it was not built for (GameBuildGuard). Read straight from
// settings.ini in DllMain, before this struct is loaded; listed here so it keeps its place
// in the file. Deliberately not shown in the F1 menu.
SETTING(bool, allowUnknownGameBuild, "AllowUnknownGameBuild", "0");
// Whether the user has answered the Wine/Proton controller prompt. 0 = not asked yet, so
// the popup appears once on a Wine/Proton launch; 1 = they picked, and it stays shut for
// good. Set it back to 0 to be asked again. Without this the prompt had no way to record
// an answer and came back every single launch.
SETTING(bool, wineControllerPromptAnswered, "WineControllerPromptAnswered", "0");
SETTING(std::string, primaryKeyboardDeviceId, "PrimaryKeyboardDeviceId", "");
SETTING(std::string, ignoredKeyboardIds, "IgnoredKeyboardIds", "");
SETTING(std::string, keyboardRenameMap, "KeyboardRenameMap", "");
SETTING(std::string, keyboardMappings, "KeyboardMappings", "");
SETTING(bool, autoUpdateControllers, "AutomaticallyUpdateControllers", "1");
SETTING(int, autoRefreshSteamGraceMs, "AutoRefreshSteamGraceMs", "0");
SETTING(int, autoRefreshFollowupDelayMs, "AutoRefreshFollowupDelayMs", "500");
SETTING(int, autoRefreshTimerIntervalMs, "AutoRefreshTimerIntervalMs", "100");
SETTING(int, uploadReplayData, "UploadReplayData", "-1");
SETTING(std::string, uploadReplayDataHost, "UploadReplayDataHost", "89.167.76.6");
SETTING(std::string, uploadReplayDataEndpoint, "UploadReplayDataEndpoint", "/upload");
SETTING(int, uploadReplayDataPort, "UploadReplayDataPort", "5000");
// Whether to speak TLS (HTTPS) to UploadReplayDataHost/Port instead of plain HTTP. Defaults
// to off to match the historical direct-IP:5000 server, which only ever spoke plain HTTP -
// flipping this default would break uploads for everyone already using that setup. Needed
// for hosts fronted by Cloudflare (e.g. a domain on port 443): Cloudflare's proxy expects a
// real TLS handshake on 443 and returns "400 The plain HTTP request was sent to HTTPS port"
// otherwise - confirmed via tools/test_replay_upload.ps1 against replays.blazqueue.com.
SETTING(bool, uploadReplayDataUseTls, "UploadReplayDataUseTls", "0");
SETTING(bool, autoArchive, "autoArchive", "0");
SETTING(float, FrameHistoryWidth, "FrameHistoryWidth", "12.0");
SETTING(float, FrameHistoryHeight, "FrameHistoryHeight", "20.0");
SETTING(float, FrameHistorySpacing, "FrameHistorySpacing", "6.0");
SETTING(bool, frameHistoryAutoReset, "FrameHistoryAutoReset", "1");
SETTING(bool, frameHistoryEnabled, "FrameHistoryEnabled", "0");
SETTING(bool, frameHistoryCountEmptyFrames, "FrameHistoryCountEmptyFrames", "0");
// Which way time runs in the frame history bar. enum: 0 = newest frame on the left, older
// ones shift right as they arrive (how it has always been); 1 = oldest on the left, newest
// pinned to the right edge. Same order as SettingsIniWindow.cpp's kFrameHistoryDirectionOptions.
SETTING(int, frameHistoryTimeDirection, "FrameHistoryTimeDirection", "0");
SETTING(std::string, language, "Language", "en");
