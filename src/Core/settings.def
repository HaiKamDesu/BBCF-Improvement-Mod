SETTING(std::string, unlimitedPlaybackTriggerKey, "UnlimitedPlaybackTriggerKeyCode", "F6");
SETTING(std::string, unlimitedPlaybackLoopKey, "UnlimitedPlaybackLoopKeyCode", "F7");
SETTING(float, unlimitedPlaybackLoopSetupSeconds, "UnlimitedPlaybackLoopSetupSeconds", "0.0");
SETTING(float, unlimitedPlaybackLoopEndingSeconds, "UnlimitedPlaybackLoopEndingSeconds", "0.0");
SETTING(bool, unlimitedPlaybackLoopRestartLabState, "UnlimitedPlaybackLoopRestartLabState", "0");
SETTING(int, unlimitedPlaybackLoopRestartMode, "UnlimitedPlaybackLoopRestartMode", "0");

// Holds 1P's inputs back by this many frames while in training mode, so a match can be
// practised at the delay online actually runs at. BBCF's netcode adds a hardcoded 2 frames
// of input delay regardless of ping (docs/Research/OnlineSimulationTrainingFeasibility.md),
// which is why 2 is the number most people want here. 0 is off; the reader clamps to 10.
// It delays the 1P side only: the dummy stays instant, so recording a playback (which is
// driven from the 2P side) is never captured through the delay.
SETTING(int, trainingInputDelay, "TrainingInputDelay", "0");
// How many action rows a dummy-action trigger shows before the rest scroll. Some people
// put a great many actions on one trigger, and the training page has to stay a page.
SETTING(int, dummyActionMaxRows, "DummyActionMaxRows", "6");
// Whether the training input delay above is suspended while the match is frozen with the
// freeze-frame hotkey. On by default: the point of freezing is to hold a button and step
// the game forward one frame at a time, and a delay line turns that into "hold the button,
// step, step, step, nothing, nothing, then it comes out". Turn it off to keep the delay
// applied even frame by frame.
SETTING(bool, trainingInputDelayIgnoreWhenFrozen, "TrainingInputDelayIgnoreWhenFrozen", "1");
// SETTING(std::string, replayDatabaseFrontendUrl, "ReplayDatabaseFrontendUrl", "http://89.167.76.6:2000/");

// Lobby avatar persistence. Puts the avatar, colour and both accessory slots you last had
// equipped back on when you connect to network mode -- including the accessory slots the
// game's own equip menu hides, which the game never saves.
//
// These fields live inside the checksummed profile blob the game uploads to Steam, so every
// write is followed by a reseal; without it, profile uploads fail and the game claims you
// have no network profile. Read src/Network/ProfileBlobSeal.h before touching any of this.
// Confirmed end to end 2026-09-05: re-apply held over both of the game's own writes,
// blobValid=1 at settle, TUS latch never tripped across a 12-minute session.
//
// 8.5.4 rewrote how this applies: it writes the avatar SOURCE fields in the save data
// manager and lets the game derive, seal and announce the profile blob itself, instead of
// poking the checksummed blob and fighting the game's refresh. That fight was failing the
// game's own profile-upload step once a second and holding lobby entry for 19-120s per
// connect on one reporter's machine. See src/Network/LobbyAvatarManager.h.
//
// The source write does NOT persist on its own: measured 2026-09-08, a session that wrote
// the source to accessory 202 was followed by one that read it back as 0/0/0/0 on arrival,
// with the icon zeroed too. The save data manager's avatar fields start empty every launch
// and are filled by the game copying the downloaded profile into them. So settings.ini
// stays the thing that remembers, and the source write exists only to stop the game's own
// rebuild undoing us inside the session.
//
// Opt-in rather than default-on by preference: it is a convenience for people who use the
// accessory slots the game's equip menu hides, and nobody else should have the mod touching
// their avatar on every connect.
//
// The four values below are written by the mod, not meant to be set by hand; -1 means
// nothing has been remembered yet, and so does anything outside the Online page's ranges
// (icon 0-47, colour 0-3, accessories 0-207).
SETTING(bool, rememberLobbyAvatar, "RememberLobbyAvatar", "0");
SETTING(int, lobbyAvatarIcon, "LobbyAvatarIcon", "-1");
SETTING(int, lobbyAvatarColor, "LobbyAvatarColor", "-1");
SETTING(int, lobbyAvatarAccessory1, "LobbyAvatarAccessory1", "-1");
SETTING(int, lobbyAvatarAccessory2, "LobbyAvatarAccessory2", "-1");

// Draw the exact HP figure over each health bar in training, the way Abyss mode does on its
// own. Training only: reading the number mid-match is a real advantage, and this is meant to
// answer "how much did that combo actually do" in the lab. See AbyssHpNumbersGate in
// src/Hooks/hooks_bbcf.cpp.
SETTING(bool, showHpNumbers, "ShowHpNumbers", "0");

// How long the game freezes after a replay takeover loads, so you can get your hands into
// position before the recorded side starts moving. Set from the takeover dialog itself.
SETTING(float, replayTakeoverSetupSeconds, "ReplayTakeoverSetupSeconds", "1.0");
